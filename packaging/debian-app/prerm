#!/bin/sh
# Stops the app and any receiver this package started when it is removed. On
# upgrade they keep running until the next login (or until Caw is opened again).
set -e
if [ "$1" = remove ] && command -v pkill >/dev/null 2>&1; then
    pkill -f '^(/usr/bin/)?caw-desktop (app|serve|pair --window)$' || true
fi
